// Cloudflare deploy config. The game is fully static (Vite builds it into dist/),
// so the Worker only serves those files: no server code, no Vite plugin needed.
{
  "name": "stone-smash",
  "compatibility_date": "2026-10-06",
  // Build before every deploy, so it works even if no build command is set in the dashboard.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  }
}
