// Cloudflare deploy config. Vite builds the game into dist/ (served as static assets);
// worker/index.ts adds the small /api/scores scoreboard backed by a D1 database.
{
  "name": "stone-smash",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  // Build before every deploy, so it works even if no build command is set in the dashboard.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
  // World scoreboard: until this is added, the game runs and simply skips the scoreboard.
  // 1. Run: npx wrangler d1 create stone-smash-scores
  // 2. Add a comma after the "assets" block above, then paste this with your database_id:
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "stone-smash-scores", "database_id": "PASTE_ID_HERE" }
  // ]
}
